# Copy this file to .env and fill in your keys. Never commit .env.
#
# The agent reads every setting through llm_config.py.

# --------------------------------------------------------------------------- #
# LLM provider: openrouter | openai | ollama | custom
# --------------------------------------------------------------------------- #
LLM_PROVIDER=openrouter

# -- OpenRouter (default) --------------------------------------------------- #
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_SITE_URL="https://github.com/PrateekT1987/ai_coding_agent"
OPENROUTER_APP_NAME="local-cursor AI Coding Agent"

# -- OpenAI ----------------------------------------------------------------- #
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# -- Local Ollama ----------------------------------------------------------- #
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="qwen2.5-coder:3b"

# -- Any OpenAI-compatible endpoint ----------------------------------------- #
# LLM_BASE_URL=""
# LLM_API_KEY=""
# LLM_MODEL=""

# Optional global model override (applies to whichever provider is active).
# AGENT_MODEL=""

# --------------------------------------------------------------------------- #
# Generation tuning
# --------------------------------------------------------------------------- #
# Reasoning models spend hidden tokens before the visible answer, so keep
# this comfortably large for coding tasks.
# AGENT_LLM_MAX_TOKENS=4096
# AGENT_LLM_TIMEOUT=300
# LLM_TEMPERATURE=0
# LLM_MAX_RETRIES=4
# LLM_RETRY_BASE_SECONDS=2

# --------------------------------------------------------------------------- #
# Embeddings for semantic code / docs search
# ollama | openai | custom | none
# --------------------------------------------------------------------------- #
# EMBEDDINGS_PROVIDER=ollama
# EMBED_MODEL=nomic-embed-text
# INDEX_EMBED_BATCH=32

# --------------------------------------------------------------------------- #
# Web search: Tavily is preferred, Exa is the fallback
# --------------------------------------------------------------------------- #
TAVILY_API_KEY=""
EXA_API_KEY=""
# WEB_SEARCH_TIMEOUT=30
